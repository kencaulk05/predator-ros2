<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>predator_bringup</name>
  <version>0.0.0</version>
  <description>Launch files, parameters and maps for the predator system</description>
  <maintainer email="ken-lbv@todo.todo">ken-lbv</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>predator_msgs</exec_depend>
  <exec_depend>predator_perception</exec_depend>
  <exec_depend>predator_behavior</exec_depend>
  <exec_depend>predator_navigation</exec_depend>
  <exec_depend>predator_manipulation</exec_depend>

  <!-- Camera driver -->
  <exec_depend>v4l2_camera</exec_depend>

  <!-- Nav2 -->
  <exec_depend>nav2_bringup</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
